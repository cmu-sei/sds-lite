{
  "name": "@cmu-sei/sds-lite",
  "version": "0.1.0",
  "description": "SDS Lite: the dependency-free, framework-neutral core of the SEI Design System.",
  "type": "module",
  "types": "./package/sds.d.ts",
  "module": "./package/sds.js",
  "style": "./sds.css",
  "customElements": "./custom-elements.json",
  "keywords": [
    "design-system",
    "css",
    "web-components",
    "accessibility",
    "framework-neutral"
  ],
  "sideEffects": [
    "**/*.css",
    "./auto.js",
    "./package/auto.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "auto.js",
    "brand.css",
    "core.css",
    "layouts.css",
    "package",
    "prose.css",
    "sds.css",
    "REFERENCE.md",
    "custom-elements.json"
  ],
  "exports": {
    ".": {
      "types": "./package/sds.d.ts",
      "import": "./package/sds.js"
    },
    "./auto": {
      "types": "./package/auto.d.ts",
      "import": "./package/auto.js"
    },
    "./dialog": {
      "types": "./package/elements/dialog.d.ts",
      "import": "./package/dialog.js"
    },
    "./dropdown": {
      "types": "./package/elements/dropdown.d.ts",
      "import": "./package/dropdown.js"
    },
    "./popover": {
      "types": "./package/elements/popover.d.ts",
      "import": "./package/popover.js"
    },
    "./tabs": {
      "types": "./package/elements/tabs.d.ts",
      "import": "./package/tabs.js"
    },
    "./tooltip": {
      "types": "./package/elements/tooltip.d.ts",
      "import": "./package/tooltip.js"
    },
    "./toast": {
      "types": "./package/elements/toast.d.ts",
      "import": "./package/toast.js"
    },
    "./sds.css": "./sds.css",
    "./core.css": "./core.css",
    "./layouts.css": "./layouts.css",
    "./prose.css": "./prose.css",
    "./brand.css": "./brand.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && vite build --config vite.library.config.ts && tsc -p tsconfig.declarations.json && node scripts/prepare-package.mjs",
    "preview": "vite preview",
    "test": "npm run build && node --test && playwright test",
    "test:browser": "playwright test",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "happy-dom": "^20.14.5",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
