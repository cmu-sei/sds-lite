{
  "name": "@cmu-sei/sds-lite",
  "version": "0.1.0",
  "description": "SDS Lite: the dependency-free, framework-neutral core of the SEI Design System.",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/cmu-sei/sds-lite#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cmu-sei/sds-lite.git"
  },
  "bugs": {
    "url": "https://github.com/cmu-sei/sds-lite/issues"
  },
  "type": "module",
  "types": "./dist/package/sds.d.ts",
  "module": "./dist/package/sds.js",
  "style": "./dist/sds.css",
  "customElements": "./custom-elements.json",
  "bin": {
    "sds-lite-migrate": "./scripts/migrate.mjs"
  },
  "keywords": [
    "design-system",
    "css",
    "web-components",
    "accessibility",
    "framework-neutral"
  ],
  "sideEffects": [
    "**/*.css",
    "./dist/package/auto.js"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "files": [
    "LICENSE",
    "dist/brand.css",
    "dist/core.css",
    "dist/layouts.css",
    "dist/package",
    "dist/prose.css",
    "dist/sds.css",
    "!dist/custom-elements.json",
    "!dist/html-data.json",
    "!dist/interface-manifest.json",
    "!dist/interface-manifest.schema.json",
    "docs",
    "framework-types",
    "html-data.json",
    "interface-manifest.json",
    "interface-manifest.schema.json",
    "custom-elements.json",
    "scripts/migrate.mjs"
  ],
  "exports": {
    ".": {
      "types": "./dist/package/sds.d.ts",
      "import": "./dist/package/sds.js"
    },
    "./auto": {
      "types": "./dist/package/auto.d.ts",
      "import": "./dist/package/auto.js"
    },
    "./dialog": {
      "types": "./dist/package/elements/dialog.d.ts",
      "import": "./dist/package/dialog.js"
    },
    "./dropdown": {
      "types": "./dist/package/elements/dropdown.d.ts",
      "import": "./dist/package/dropdown.js"
    },
    "./popover": {
      "types": "./dist/package/elements/popover.d.ts",
      "import": "./dist/package/popover.js"
    },
    "./tabs": {
      "types": "./dist/package/elements/tabs.d.ts",
      "import": "./dist/package/tabs.js"
    },
    "./tooltip": {
      "types": "./dist/package/elements/tooltip.d.ts",
      "import": "./dist/package/tooltip.js"
    },
    "./toast": {
      "types": "./dist/package/elements/toast.d.ts",
      "import": "./dist/package/toast.js"
    },
    "./react": {
      "types": "./framework-types/react.d.ts",
      "import": "./framework-types/empty.js"
    },
    "./vue": {
      "types": "./framework-types/vue.d.ts",
      "import": "./framework-types/empty.js"
    },
    "./html-data.json": "./html-data.json",
    "./interface-manifest.json": "./interface-manifest.json",
    "./sds.css": "./dist/sds.css",
    "./core.css": "./dist/core.css",
    "./layouts.css": "./dist/layouts.css",
    "./prose.css": "./dist/prose.css",
    "./brand.css": "./dist/brand.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "check:package": "node scripts/check-package.mjs",
    "generate:interface": "node scripts/generate-interface.mjs",
    "prebuild": "node scripts/generate-interface.mjs --check",
    "dev": "vite",
    "build": "tsc && vite build && vite build --config vite.library.config.ts && tsc -p tsconfig.declarations.json && node scripts/prepare-package.mjs",
    "preview": "vite preview",
    "release:prepare": "node scripts/prepare-release.mjs",
    "test": "npm run build && npm run test:standards && node --test && playwright test && npm run test:workspace",
    "test:browser": "playwright test",
    "test:standards": "html-validate index.html",
    "test:workspace": "node --test test/workspace-hygiene.test.mjs",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "npm@11.6.4",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "happy-dom": "^20.14.5",
    "html-validate": "^10.17.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
