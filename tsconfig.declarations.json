{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "outDir": "package",
    "rewriteRelativeImportExtensions": true,
    "rootDir": "src"
  },
  "include": ["src/auto.ts", "src/sds.ts", "src/elements/*.ts"]
}
