{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cdn.jsdelivr.net/gh/cmu-sei/sds-lite@v0.4.0/dist/interface-manifest.schema.json",
  "title": "SDS Lite interface manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "globalAttributes", "optionFamilies", "recipes", "customElements"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"type": "string"},
    "globalAttributes": {
      "type": "array",
      "items": {"$ref": "#/$defs/attribute"}
    },
    "optionFamilies": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description", "values"],
        "properties": {
          "nativeName": {"type": "string"},
          "description": {"type": "string"},
          "values": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "recipes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "category", "classes", "description", "options"],
        "properties": {
          "name": {"type": "string"},
          "category": {"type": "string"},
          "classes": {"type": "array", "items": {"type": "string"}},
          "elements": {"type": "array", "items": {"type": "string"}},
          "description": {"type": "string"},
          "requirements": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "defaults": {
            "type": "object",
            "description": "Legacy display defaults. Consult omissionDefaults before interpreting a value as a literal attribute default.",
            "additionalProperties": {
              "type": ["string", "boolean"]
            }
          },
          "omissionDefaults": {
            "type": "object",
            "description": "Behavior when the attribute is omitted. These descriptions are not accepted literal values; remove the attribute to reset it.",
            "additionalProperties": {"type": "string", "minLength": 1}
          },
          "options": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {"type": "string"}
            }
          },
          "optionTypes": {
            "type": "object",
            "additionalProperties": {"enum": ["id", "string"]}
          },
          "optionTargets": {
            "type": "object",
            "additionalProperties": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "customElements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tagName", "className", "module", "description", "content", "attributes", "members"],
        "properties": {
          "tagName": {"type": "string"},
          "className": {"type": "string"},
          "module": {"type": "string"},
          "description": {"type": "string"},
          "content": {
            "type": "array",
            "items": {"type": "string"}
          },
          "attributes": {
            "type": "array",
            "items": {"$ref": "#/$defs/attribute"}
          },
          "members": {"type": "array", "items": {"$ref": "#/$defs/member"}},
          "events": {"type": "array", "items": {"$ref": "#/$defs/event"}}
        }
      }
    },
    "compositions": {
      "type": "array",
      "items": {"$ref": "#/$defs/composition"}
    }
  },
  "$defs": {
    "attribute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {"type": "string"},
        "description": {"type": "string"},
        "type": {"type": "string"},
        "family": {"type": "string"},
        "values": {"type": "array", "items": {"type": "string"}},
        "default": {"type": "string"}
      }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "description"],
      "properties": {
        "kind": {"enum": ["field", "method"]},
        "name": {"type": "string", "minLength": 1},
        "type": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "parameters": {"type": "array", "items": {"$ref": "#/$defs/parameter"}}
      },
      "allOf": [{
        "if": {"properties": {"kind": {"const": "field"}}},
        "then": {"required": ["type"], "properties": {"type": {"type": "string", "minLength": 1}, "parameters": false}}
      }]
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "type": {"type": "string", "minLength": 1},
        "default": {"type": "string"}
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "detail", "description"],
      "properties": {
        "name": {"type": "string", "pattern": "^sds-[a-z-]+$"},
        "type": {"type": "string", "pattern": "^CustomEvent<.+>$"},
        "detail": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "recipes", "customElements", "stylesheets", "assets", "requiresSetup", "parts", "applicationResponsibilities"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "kind": {"enum": ["pattern", "layout"]},
        "recipes": {"$ref": "#/$defs/stringList"},
        "customElements": {"$ref": "#/$defs/stringList"},
        "stylesheets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["sds.css", "brand.css"]}},
        "assets": {"$ref": "#/$defs/stringList"},
        "requiresSetup": {"type": "boolean"},
        "parts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["selector", "minimum"],
            "properties": {
              "selector": {"type": "string", "minLength": 1},
              "minimum": {"type": "integer", "minimum": 1}
            }
          }
        },
        "applicationResponsibilities": {"$ref": "#/$defs/stringList"}
      }
    },
    "stringList": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
