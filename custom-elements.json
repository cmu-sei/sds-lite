    {
      "kind": "javascript-module",
      "path": "dist/package/tabs.js",
      "declarations": [
        {
          "kind": "class",
          "name": "SdsTabsElement",
          "tagName": "sds-tabs",
          "description": "Coordinates a tab list and one panel per tab. Content model: A direct child tab-list container with button or link children. One direct child panel for every tab.",
          "attributes": [
            {
              "name": "value",
              "type": {
                "text": "string"
              },
              "description": "Value of the selected tab."
            },
            {
              "name": "activation",
              "type": {
                "text": "\"automatic\" | \"manual\""
              },
              "description": "Whether focus automatically selects a tab."
            },
            {
              "name": "orientation",
              "type": {
                "text": "\"horizontal\" | \"vertical\""
              },
              "description": "Layout or interaction orientation."
            },
            {
              "name": "size",
              "type": {
                "text": "\"md\" | \"lg\""
              },
              "description": "Visual scale."
            },
            {
              "name": "tone",
              "type": {
                "text": "\"neutral\" | \"accent\" | \"info\" | \"success\" | \"warning\" | \"danger\""
              },
              "description": "Semantic color intent."
            },
            {
              "name": "variant",
              "type": {
                "text": "\"folder\" | \"block\" | \"underline\""
              },
              "description": "Visual treatment."
            }
          ],
          "members": [
            {
              "kind": "field",
              "name": "value",
              "type": {
                "text": "string"
              },
              "description": "Gets or selects the current tab by value."
            },
            {
              "kind": "field",
              "name": "activation",
              "type": {
                "text": "SdsTabsActivation"
              },
              "description": "Reflects the activation attribute."
            },
            {
              "kind": "field",
              "name": "orientation",
              "type": {
                "text": "SdsOrientation"
              },
              "description": "Reflects the orientation attribute."
            },
            {
              "kind": "field",
              "name": "size",
              "type": {
                "text": "SdsTabsSize"
              },
              "description": "Reflects the size attribute."
            },
            {
              "kind": "field",
              "name": "tone",
              "type": {
                "text": "SdsTone"
              },
              "description": "Reflects the tone attribute."
            },
            {
              "kind": "field",
              "name": "variant",
              "type": {
                "text": "SdsTabsVariant"
              },
              "description": "Reflects the variant attribute."
            }
          ],
          "events": [
            {
              "name": "sds-change",
              "type": {
                "text": "CustomEvent<SdsTabsChangeDetail>"
              },
              "description": "Dispatched when user interaction selects a new tab."
            }
          ]
        }
      ]
    },
    {
      "kind": "javascript-module",
      "path": "dist/package/tooltip.js",
      "declarations": [
        {
          "kind": "class",
          "name": "SdsTooltipElement",
          "tagName": "sds-tooltip",
          "description": "Enhances a direct child trigger and short description with accessible tooltip behavior. Content model: One direct child trigger. One direct child text description.",
          "attributes": [
            {
              "name": "placement",
              "type": {
                "text": "\"block-start\" | \"block-start-start\" | \"block-start-end\" | \"block-end\" | \"block-end-start\" | \"block-end-end\" | \"inline-start\" | \"inline-start-start\" | \"inline-start-end\" | \"inline-end\" | \"inline-end-start\" | \"inline-end-end\""
              },
              "description": "Preferred logical floating placement."
            },
            {
              "name": "offset",
              "type": {
                "text": "number"
