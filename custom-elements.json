{
  "schemaVersion": "1.0.0",
  "readme": "docs/README.md",
  "modules": [
    {
      "kind": "javascript-module",
      "path": "dist/package/dropdown.js",
      "declarations": [
        {
          "kind": "class",
          "name": "SdsDropdownElement",
          "tagName": "sds-dropdown",
          "description": "Enhances a direct child button and menu with Popover positioning and menu keyboard behavior. Content model: One direct child button trigger. One direct child menu or Popover surface.",
          "attributes": [
            {
              "name": "open",
              "type": {
                "text": "boolean"
              },
              "description": "Whether the menu is open."
            },
            {
              "name": "placement",
              "type": {
                "text": "\"block-start\" | \"block-start-start\" | \"block-start-end\" | \"block-end\" | \"block-end-start\" | \"block-end-end\" | \"inline-start\" | \"inline-start-start\" | \"inline-start-end\" | \"inline-end\" | \"inline-end-start\" | \"inline-end-end\""
              },
              "description": "Preferred logical floating placement."
            },
            {
              "name": "offset",
              "type": {
                "text": "number"
              },
              "description": "Nonnegative offset in CSS pixels."
            },
            {
              "name": "width",
              "type": {
                "text": "\"auto\" | \"sm\" | \"md\" | \"lg\" | \"xl\" | \"2xl\""
              },
              "description": "Recipe or overlay width."
            },
            {
              "name": "hide-caret",
              "type": {
                "text": "boolean"
              },
              "description": "Hides the visual caret."
            }
          ],
          "members": [
            {
              "kind": "field",
              "name": "open",
              "type": {
                "text": "boolean"
              },
              "description": "Reflects the open attribute."
            },
            {
              "kind": "field",
              "name": "placement",
              "type": {
                "text": "SdsPlacement"
              },
              "description": "Reflects the placement attribute."
            },
            {
              "kind": "field",
              "name": "offset",
              "type": {
                "text": "number"
              },
              "description": "Reflects the offset attribute."
            },
            {
              "kind": "field",
              "name": "width",
              "type": {
                "text": "SdsWidth"
              },
              "description": "Reflects the width attribute."
            },
            {
              "kind": "field",
              "name": "hideCaret",
              "type": {
                "text": "boolean"
              },
              "description": "Reflects the hide-caret attribute."
            },
            {
              "kind": "method",
              "name": "show",
              "description": "Opens the menu."
            },
            {
              "kind": "method",
              "name": "hide",
              "description": "Closes the menu."
            }
          ],
          "events": [
            {
              "name": "sds-toggle",
              "type": {
                "text": "CustomEvent<SdsToggleDetail>"
              },
              "description": "Dispatched after the open state changes."
            }
          ]
        }
      ]
    },
