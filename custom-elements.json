          ],
          "members": [
            {
              "kind": "field",
              "name": "placement",
              "type": {
                "text": "SdsPlacement"
              },
              "description": "Reflects the placement attribute."
            },
            {
              "kind": "field",
              "name": "offset",
              "type": {
