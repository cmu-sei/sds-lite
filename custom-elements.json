    {
      "kind": "javascript-module",
      "path": "dist/package/toast.js",
      "declarations": [
        {
          "kind": "class",
          "name": "SdsToastElement",
          "tagName": "sds-toast",
          "description": "A timed or persistent notification. Content model: A direct child strong title. Message content. A close control for persistent notifications.",
          "attributes": [
            {
              "name": "open",
              "type": {
                "text": "boolean"
              },
              "description": "Whether the toast is visible."
            },
            {
              "name": "tone",
              "type": {
                "text": "\"neutral\" | \"accent\" | \"info\" | \"success\" | \"warning\" | \"danger\""
              },
              "description": "Semantic color intent."
            },
            {
              "name": "duration",
              "type": {
                "text": "number"
              },
              "description": "Positive duration in milliseconds."
            },
            {
              "name": "persistent",
              "type": {
                "text": "boolean"
              },
              "description": "Disables automatic dismissal."
            }
          ],
          "members": [
            {
              "kind": "field",
              "name": "open",
              "type": {
                "text": "boolean"
              },
              "description": "Reflects the open attribute."
            },
            {
              "kind": "field",
              "name": "tone",
              "type": {
                "text": "SdsTone"
              },
              "description": "Reflects the tone attribute."
            },
            {
              "kind": "field",
              "name": "duration",
              "type": {
                "text": "number"
              },
              "description": "Reflects the duration attribute."
            },
            {
              "kind": "field",
              "name": "persistent",
              "type": {
                "text": "boolean"
              },
              "description": "Reflects the persistent attribute."
            },
            {
              "kind": "method",
              "name": "show",
              "description": "Opens the toast and starts its timer."
            },
            {
              "kind": "method",
              "name": "close",
              "description": "Closes the toast.",
              "parameters": [
                {
                  "name": "reason",
                  "type": {
                    "text": "SdsToastCloseReason"
                  },
                  "default": "'programmatic'"
                }
              ]
            }
          ],
          "events": [
            {
              "name": "sds-open",
              "type": {
                "text": "CustomEvent<void>"
              },
              "description": "Dispatched when show() opens the toast."
            },
            {
              "name": "sds-close",
              "type": {
                "text": "CustomEvent<{ reason: SdsToastCloseReason }>"
              },
              "description": "Dispatched when the toast closes."
            }
          ]
        }
      ]
    }
